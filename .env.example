APP_ENV=development
JURY_API_KEY=
DETECTOR_BACKEND=cv
CV_DEVICE=auto
CV_MODEL_DIR=./models
# Set to a versioned training output directory after training; omit for the legacy local scorer.
# CV_SCORER_DIR=./models/scorers/YOUR_RUN_ID
CV_NUM_THREADS=2
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_VISION_MODEL=
ALLOWED_OLLAMA_HOSTS=[]
ENABLE_DEMO=false
MAX_UPLOAD_MB=100
MAX_VIDEO_SECONDS=300
JOB_DEADLINE_SECONDS=285
WORKER_CONCURRENCY=1
STORAGE_DIR=./storage
RULES_FILE=./config/rules.json
RETENTION_HOURS=
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
SAMPLING_FPS=2
WINDOW_SECONDS=16
MAX_SAMPLE_FRAMES=600
SAMPLE_WIDTH=640
MAX_EVENTS=24
MAX_EVIDENCE_BYTES=12582912
OLLAMA_TIMEOUT_SECONDS=45
MAX_QUEUE_SIZE=8
MAX_STORAGE_MB=2048
MAX_JOB_OUTPUT_MB=256
UPLOAD_RATE_PER_HOUR=12
SESSION_HOURS=24
WORKER_HEARTBEAT_SECONDS=15
SECURE_COOKIES=false
PUBLIC_ORIGIN=
ENABLE_LOCAL_REVIEW=false
LOCAL_REVIEW_LABELS=./reports/training/labels-validation.json
LOCAL_REVIEW_VIDEO_ROOT=./data/videos
LOCAL_REVIEW_DATA_DIR=./data/annotations
